<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>waypoint_label</name>
  <version>0.1.0</version>
  <description>VLM-based region semantic labeler for the TypeGo place graph. Buffers pose-tagged camera frames, buckets them to places, and writes structured labels back via the place_graph node's SetPlaceLabel service.</description>
  <maintainer email="chengj0803@gmail.com">guojun</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>typego_interface</depend>

  <!-- semantics.launch.py imports typego_config.bootstrap -->
  <exec_depend>typego_config</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-pil</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
