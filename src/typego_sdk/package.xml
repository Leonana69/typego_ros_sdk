<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>typego_sdk</name>
  <version>0.0.0</version>
  <description>ROS2 SDK for TypeGo</description>
  <maintainer email="guojun.chen@yale.edu">Guojun Chen</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>


  <depend>rclcpp</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>

  <depend>typego_interface</depend>
  <depend>rcl_interfaces</depend>
  <depend>place_graph</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>std_msgs</depend>
  <depend>ament_index_cpp</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <!-- typego_bringup.launch.py imports typego_config.bootstrap -->
  <exec_depend>typego_config</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>place_graph_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
